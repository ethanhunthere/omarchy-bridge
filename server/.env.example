# Bridge Server Port
PORT=19001

# Bind host (0.0.0.0 listens on LAN, Tailscale, and localhost)
HOST=0.0.0.0

# Pre-Shared Authentication Secret (Replace with your own secure token)
AUTH_TOKEN=generate-a-secure-random-token-here

# Target CLI or Shell executable
SHELL_CMD=/usr/bin/fish

# Target Working Directory (defaults to user home directory if omitted)
# WORK_DIR=/home/username

# Scrollback Ring Buffer capacity (in bytes) - default 512KB
BUFFER_MAX_BYTES=524288
