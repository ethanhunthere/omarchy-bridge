# Bridge Server Port
PORT=8080

# Bind host (0.0.0.0 listens on LAN, Tailscale, and localhost)
HOST=0.0.0.0

# Pre-Shared Authentication Secret (Replace with your own high-entropy token or leave blank to auto-generate)
AUTH_TOKEN=super-secret-omarchy-token-12345

# Target CLI or Shell executable
# For interactive bash/zsh shell:
SHELL_CMD=/bin/bash

# Target Working Directory
WORK_DIR=/home/f0id

# Scrollback Ring Buffer capacity (in bytes) - default 512KB
BUFFER_MAX_BYTES=524288
