PORT=19001
HOST=0.0.0.0

# Persistent pre-shared authentication secret
AUTH_TOKEN=omarchy-bridge-secure-key-2026

# Dedicated detached tmux session name
TMUX_SESSION=omarchy-remote

# Default interactive login shell (fish, bash, or zsh)
SHELL_CMD=/usr/bin/fish

# Base working directory for sessions
WORK_DIR=/home/f0id

# Scrollback Ring Buffer size (bytes)
BUFFER_MAX_BYTES=524288
