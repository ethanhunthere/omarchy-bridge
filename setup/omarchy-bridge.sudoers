# Scoped passwordless permissions for Omarchy Remote Control Center
# Allows the background bridge daemon to power manage without interactive password prompts
%wheel ALL=(ALL) NOPASSWD: /usr/bin/systemctl poweroff, /usr/bin/systemctl reboot, /usr/bin/systemctl suspend, /usr/bin/rtcwake, /usr/bin/powerprofilesctl, /usr/bin/ethtool, /usr/bin/iw
f0id ALL=(ALL) NOPASSWD: /usr/bin/systemctl poweroff, /usr/bin/systemctl reboot, /usr/bin/systemctl suspend, /usr/bin/rtcwake, /usr/bin/powerprofilesctl, /usr/bin/ethtool, /usr/bin/iw
