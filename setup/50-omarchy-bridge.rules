// Polkit rule for Omarchy Remote Control Center
// Allows power-off, reboot, and suspend actions without authentication prompts
polkit.addRule(function(action, subject) {
    if ((action.id == "org.freedesktop.login1.power-off" ||
         action.id == "org.freedesktop.login1.power-off-multiple-sessions" ||
         action.id == "org.freedesktop.login1.reboot" ||
         action.id == "org.freedesktop.login1.reboot-multiple-sessions" ||
         action.id == "org.freedesktop.login1.suspend" ||
         action.id == "org.freedesktop.login1.suspend-multiple-sessions" ||
         action.id == "org.freedesktop.login1.inhibit-handle-sleep" ||
         action.id == "org.freedesktop.login1.inhibit-handle-lid-switch") &&
        (subject.isInGroup("wheel") || subject.user == "f0id")) {
        return polkit.Result.YES;
    }
});
